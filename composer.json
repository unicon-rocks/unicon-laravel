{
	"name": "unicon-rocks/unicon-laravel",
	"description": "Universal icon component for Laravel",
	"type": "library",
	"license": "MIT",
	"autoload": {
		"psr-4": {
			"Unicon\\": "src/"
		},
		"files": ["src/functions.php"]
	},
	"authors": [
		{
			"name": "Nicolas Hedger",
			"email": "nicolas@hedger.ch"
		}
	],
	"minimum-stability": "stable",
	"require": {
		"php": ">=8.2",
		"illuminate/console": "^13|^12",
		"illuminate/support": "^13|^12",
		"guzzlehttp/guzzle": "^7"
	},
	"require-dev": {
		"orchestra/testbench": "^10 || ^11",
		"laravel/pint": "^1.18",
		"phpunit/phpunit": "^13 || ^12 || ^11"
	},
	"autoload-dev": {
		"psr-4": {
			"Unicon\\Test\\": "test/"
		}
	},
	"scripts": {
		"test": "@php vendor/bin/phpunit --colors=always",
		"lint": ["@php vendor/bin/phpstan analyse --verbose --ansi"],
		"format": "@php vendor/bin/pint --repair"
	},
	"extra": {
		"laravel": {
			"providers": ["Unicon\\IconServiceProvider"],
			"aliases": {
				"Icon": "Unicon\\Facades\\Icon"
			}
		}
	}
}
